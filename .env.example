# Copy to .env and fill in. Never commit .env.
# Optional: without a key, Semantic Scholar uses a shared (frequently rate-limited) pool.
SEMANTIC_SCHOLAR_API_KEY=

# Optional: defaults to sqlite:///<repo>/backend/library.db
# DATABASE_URL=sqlite:////absolute/path/to/library.db

# Required for paper summaries and Q&A.
OPENAI_API_KEY=
# Optional: defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
